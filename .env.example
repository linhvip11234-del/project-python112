# Cấu hình demo Django
SECRET_KEY=demo-secret-key-change-me
DEBUG=True

# Bật chatbot AI thật nếu có API key
# Nếu không điền OPENAI_API_KEY, chatbot vẫn chạy bằng fallback thông minh nội bộ.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions

# Email demo nếu dùng chức năng quên mật khẩu OTP qua email
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
