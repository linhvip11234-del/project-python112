# Cấu hình local cho Django Lumière
SECRET_KEY=demo-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.trycloudflare.com

# Gmail SMTP dùng gửi OTP khôi phục mật khẩu
# EMAIL_HOST_PASSWORD là Gmail App Password 16 ký tự, không phải mật khẩu Gmail thường.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=yourgmail@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password_16_chars
DEFAULT_FROM_EMAIL=yourgmail@gmail.com
EMAIL_TIMEOUT=15

# Chatbot AI nếu có API key. Nếu bỏ trống, hệ thống dùng fallback nội bộ.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
OPENAI_TIMEOUT=20
